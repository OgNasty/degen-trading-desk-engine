# Copy to .env in the bot folder. Never commit or share .env. Never paste these into chat.
# Paper mode is ON by default: no transaction is ever broadcast while this is true.
PAPER_TRADING=true

# Public address of the trading wallet (safe to show).
WALLET_ADDRESS=YOUR_PUBLIC_SOLANA_ADDRESS
# Base58 private key of the trading wallet. Enter through a masked secret prompt only.
SOLANA_TRADING_PRIVATE_KEY=

# Solana RPC. Helius is required (reads + sends). Alchemy is an optional backup (reads + capped re-quote send).
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
ALCHEMY_RPC_URL=
# (Legacy alternative: SOLANA_RPC_URLS=helius_url[,alchemy_url]. The public RPC is added automatically, read-only.)

# Jupiter API key (free tier at portal.jup.ag). Optional: keyless fallback is used without it.
JUPITER_API_KEY=

# Optional: alerts webhook.
TRADING_ALERT_WEBHOOK_URL=
TRADING_ALERT_WEBHOOK_KEY=

# Dashboard on the owner's own free Cloudflare account (required for the dashboard).
DEGEN_WORKER_NAME=degen-dashboard
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
DEGEN_DASHBOARD_ORIGIN=

# Optional overrides
DEGEN_HOME=
# Check interval override in seconds (default: 300 on the box, 60 on a PC)
DEGEN_RUNNER_INTERVAL_SEC=
# Override config.json run_side (box | pc)
DEGEN_RUN_SIDE=
